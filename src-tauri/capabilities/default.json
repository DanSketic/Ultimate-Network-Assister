{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window chrome is drawn by the app, so the main window needs the controls it replaces, plus clipboard writes for the reference commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
